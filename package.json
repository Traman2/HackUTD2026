{
  "name": "hackutd2026",
  "private": true,
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev:web": "pnpm --dir apps/web dev",
    "dev:spacetime": "spacetime dev",
    "start:spacetime": "spacetime start --listen-addr 127.0.0.1:3000 --data-dir .spacetime-data --non-interactive",
    "publish:spacetime": "spacetime publish hackutd2026 --server local --module-path ./spacetimedb",
    "build:web": "pnpm --dir apps/web build",
    "build:spacetime": "spacetime build --module-path ./spacetimedb",
    "generate:spacetime": "spacetime generate --lang typescript --module-path ./spacetimedb --out-dir ./apps/web/src/module_bindings",
    "typecheck:spacetime": "pnpm --dir spacetimedb exec tsc"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.18.0",
  "type": "module"
}
