# Load these in the Node.js process running backend LangChain agents.
AWS_REGION=us-east-1
AGENT_API_KEY=replace-with-a-random-shared-secret
AGENT_URL=http://127.0.0.1:3001/invoke
AGENT_HOST=127.0.0.1
AGENT_PORT=3001
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
# Loaded by dev:agent before any LangChain/Deep Agents modules initialize.
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_AGENT_ID=hackutd
LANGSMITH_AGENT_ENVIRONMENT=local
# Agent writes generated graphs and page findings to SpacetimeDB.
SPACETIMEDB_HOST=http://127.0.0.1:3000
SPACETIMEDB_DB_NAME=hackutd2026
# Unique per application/database deployment; loaded into the database on publish.
GRAPH_NAMESPACE=hackutd2026
# Use an IAM role, a shared AWS profile, or environment credentials.
# AWS_PROFILE=default
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# PDF storage: the normal publish command loads this file (see STORAGE.md).
# The database signer uses these explicit credentials, not AWS_PROFILE.
S3_BUCKET=your-private-pdf-bucket
S3_REGION=us-east-1
S3_PREFIX=hackutd2026
# Optional dedicated bucket for ticket photos from the glasses/phone (see TICKET_PHOTOS.md).
# Leave unset to store photos in S3_BUCKET under the same prefix.
# S3_PHOTO_BUCKET=your-private-photo-bucket
# S3_PHOTO_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Required only for temporary credentials:
# S3_SESSION_TOKEN=
