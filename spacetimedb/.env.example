# Load these in the Node.js process running backend LangChain agents.
AWS_REGION=us-east-1
AGENT_API_KEY=replace-with-a-random-shared-secret
AGENT_URL=http://127.0.0.1:3001/invoke
AGENT_HOST=127.0.0.1
AGENT_PORT=3001
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
# Use an IAM role, a shared AWS profile, or environment credentials.
# AWS_PROFILE=default
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# PDF storage: the normal publish command loads this file (see STORAGE.md).
# The database signer uses these explicit credentials, not AWS_PROFILE.
S3_BUCKET=your-private-pdf-bucket
S3_REGION=us-east-1
S3_PREFIX=hackutd2026
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Required only for temporary credentials:
# S3_SESSION_TOKEN=
