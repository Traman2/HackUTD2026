# Load these in the Node.js process running backend LangChain agents.
AWS_REGION=us-east-1
AGENT_API_KEY=replace-with-a-random-shared-secret
AGENT_URL=http://127.0.0.1:3001/invoke
AGENT_HOST=127.0.0.1
AGENT_PORT=3001
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
# Use an IAM role, a shared AWS profile, or environment credentials.
# AWS_PROFILE=default
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
